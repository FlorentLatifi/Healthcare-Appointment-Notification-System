# Non-secret production configuration (safe to commit).
# Secrets belong in .env.secrets or secrets/* files — never here.

ASPNETCORE_ENVIRONMENT=Production

Jwt__Issuer=HealthcareAPI
Jwt__Audience=HealthcareClients
Jwt__ExpirationInMinutes=15
Jwt__RefreshTokenExpirationInDays=7
Jwt__ClockSkewSeconds=60

Redis__ConnectionString=redis:6379,abortConnect=false,connectTimeout=5000,syncTimeout=5000
Redis__InstanceName=HealthcareApp:Prod:
Redis__DefaultLockExpirationSeconds=30

Cache__Enabled=true
Cache__DoctorCatalogTtlSeconds=300
Cache__DoctorScheduleTtlSeconds=1800
Cache__AvailabilityTtlSeconds=60

UseOutboxForDomainEvents=true
Outbox__RelayIntervalSeconds=10
Outbox__MaxRetryAttempts=5
Outbox__BatchSize=50
Outbox__BaseRetryDelaySeconds=5
Outbox__MaxRetryDelaySeconds=300
Outbox__ProcessingLeaseSeconds=120
Outbox__CircuitBreakerFailureThreshold=5
Outbox__CircuitBreakerBreakSeconds=60

Seeding__SeedDemoData=false
Seeding__AllowDemoDataOutsideDevelopment=false
Seeding__BootstrapAdmin__Enabled=false

Stripe__DefaultCurrency=USD

# Override via .env.secrets or deploy vars when needed:
# FRONTEND_URL=https://app.example.com
# TrustedNetworks__0=172.16.0.0/12
