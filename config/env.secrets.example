# ────────────────────────────────────────────────────────────────────
# SECRETS TEMPLATE — copy to /opt/healthcare/.env.secrets (mode 600)
# Never commit a filled copy of this file.
# ────────────────────────────────────────────────────────────────────

# Required
DB_PASSWORD=change-me-strong-sql-password-Here1!
JWT_SECRET=change-me-use-openssl-rand-base64-48-minimum-32-chars

# Stripe (production = sk_live_ / pk_live_ ; staging = sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public origin for CORS (not a password, but environment-specific)
FRONTEND_URL=https://app.example.com

# One-time first admin (leave disabled after bootstrap)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: OpenTelemetry
# OTEL_ENDPOINT=http://otel-collector:4317
