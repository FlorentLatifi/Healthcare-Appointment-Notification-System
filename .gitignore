# ── Secrets & environment (never commit filled values) ─────────────
.env
.env.*
!.env.example
!**/.env.example
**/.env
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example

# Host / deploy secrets (local or server copies)
.env.secrets
**/.env.secrets
*.secrets
secrets/*
!secrets/.gitignore
!secrets/.gitkeep
!secrets/README.md

# Stripe / API key dumps, accidental secret dumps
*.pem
*.p12
*.pfx
*.key
id_rsa
id_rsa.*
*.secret.json

