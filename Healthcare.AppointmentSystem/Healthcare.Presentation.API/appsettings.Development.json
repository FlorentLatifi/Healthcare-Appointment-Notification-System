{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Warning",
            "Healthcare.Adapters.Locking": "Trace"
        }
    },

    "Redis": {
        "ConnectionString": "localhost:6379",
        "InstanceName": "HealthcareApp:Dev:",
        "DefaultLockExpirationSeconds": 30
    },

    "UseOutboxForDomainEvents": false,

    "AllowedOrigins": [
        "http://localhost:5173",
        "https://localhost:5173"
    ],

    "App": {
        "ResetPasswordBaseUrl": "http://localhost:5173/reset-password"
    },

    "Seeding": {
        "SeedDemoData": true,
        "AllowDemoDataOutsideDevelopment": false,
        "BootstrapAdmin": {
            "Enabled": true,
            "Username": "admin",
            "Email": "admin@localhost.dev",
            "Password": ""
        }
    }
}