# API base URL for the browser.
# Local Vite: use relative /api/v1 (proxied to Kestrel — see vite.config.js).
# Docker/nginx same-origin: use /api/v1
# Direct cross-origin (not recommended for cookies): https://localhost:7039/api/v1
VITE_API_BASE_URL=/api/v1

# Optional: override Vite proxy target (default http://localhost:5171)
# VITE_API_PROXY_TARGET=http://localhost:5171

# Stripe publishable key (test mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
