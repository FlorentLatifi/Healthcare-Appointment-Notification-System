# ────────────────────────────────────────────────────────────────────
# LOCAL DOCKER ONLY — copy to .env (never commit .env)
#
#   copy .env.example .env     (Windows PowerShell: Copy-Item .env.example .env)
#   docker compose up --build -d
#
# Production uses config/production.env + .env.secrets on the server.
# See docs/secrets-management.md and docs/deployment.md
# ────────────────────────────────────────────────────────────────────

# SQL Server SA password (required). Must meet SQL complexity rules
# (upper, lower, number, symbol; long enough). Change for anything beyond local.
DB_PASSWORD=YourStr0ng!Pass

# JWT signing secret (required). At least 32 random characters.
# Generate: openssl rand -base64 48
JWT_SECRET=super-secret-key-that-is-at-least-32-characters-long

# ── Stripe (optional for browsing/booking; required for real card payments) ──
# Get test keys: https://dashboard.stripe.com/test/apikeys
# Leave as empty or placeholder if you only need login/booking without pay.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Webhook signing secret (CLI or Dashboard → Webhooks). Needed for webhook handler.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# First admin password for local Docker bootstrap.
# Leave EMPTY to get a one-time random password in: docker compose logs api
# Or set a strong password (min 12 chars, mixed case, digit, symbol).
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend build-time API URL (baked into the Vite/nginx image).
# For local compose the browser calls the host-mapped API port:
VITE_API_BASE_URL=http://localhost:5171/api/v1
