# SQL Server SA password (min 8 chars, must contain uppercase, lowercase, digits, and special chars)
DB_PASSWORD=YourStr0ng!Pass

# JWT secret key (min 32 characters)
JWT_SECRET=super-secret-key-that-is-at-least-32-characters-long

# Stripe test-mode keys (replace with real keys from https://dashboard.stripe.com/test/apikeys)
# These start with sk_test_ / pk_test_
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# --- First admin bootstrap (optional for local Docker) ---
# Strong password (min 12 chars, upper+lower+digit+special). Never use Admin123! or other defaults.
# Leave empty in local non-Production to auto-generate once (password is logged only at first seed).
# Required in Production when BOOTSTRAP_ADMIN_ENABLED=true.
BOOTSTRAP_ADMIN_PASSWORD=

# Production-only (docker-compose.prod.yml). Keep false after the first admin exists.
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=you@your-org.com
