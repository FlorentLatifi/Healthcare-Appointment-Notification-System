# ────────────────────────────────────────────────────────────────────
# LOCAL DOCKER — do not commit this file
# Copy from .env.example and fill real Stripe keys when you need payments.
# ────────────────────────────────────────────────────────────────────

# Required — SQL Server SA password (complexity: upper/lower/number/symbol)
DB_PASSWORD=YourStr0ng!Pass

# Required — JWT HS256 secret (≥32 chars). Rotate for any shared/demo host.
JWT_SECRET=super-secret-key-that-is-at-least-32-characters-long

# Stripe TEST keys — replace with real sk_test_ / pk_test_ from Stripe Dashboard
# for card payments. Placeholders work for login/booking only.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Leave empty = random admin password once, printed in: docker compose logs api
# Or set e.g. MyLocalAdmin!Pass1  (change after first login)
BOOTSTRAP_ADMIN_PASSWORD=

# Baked into frontend image at build time (browser → host API)
VITE_API_BASE_URL=http://localhost:5171/api/v1
